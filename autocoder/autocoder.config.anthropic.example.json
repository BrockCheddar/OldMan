{
  "llm": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "api_key_env": "ANTHROPIC_API_KEY"
  },
  "budget": {
    "max_subtask_attempts": 3,
    "max_replan_cycles": 2,
    "max_steps_per_attempt": 40,
    "max_output_tokens": 8000,
    "max_wall_clock_seconds": 21600,
    "default_command_timeout": 300
  },
  "approval": {
    "mode": "smart"
  }
}
